# ============================================================
# VaultIQ — Environment Variables
# ============================================================
# LOCAL:  copy to .env.local and fill in your values
# VERCEL: Settings → Environment Variables → add each key
# NEVER commit .env.local to git
# ============================================================

# REQUIRED — https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OPTIONAL — defaults shown
VAULTIQ_MODEL=claude-sonnet-4-20250514
VAULTIQ_MAX_TOKENS=1024
VAULTIQ_MAX_HISTORY=20
NEXT_PUBLIC_APP_URL=https://vaultiq.vercel.app
NEXT_PUBLIC_APP_NAME=VaultIQ

# ADD LATER (uncomment when ready)
# STRIPE_SECRET_KEY=sk_test_your-key
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
# RESEND_API_KEY=re_your-key
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
